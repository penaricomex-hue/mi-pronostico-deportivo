{
  "name": "mi-pronostico-deportivo",
  "private": true,
  "version": "10.1.0",
  "description": "MK Bets: pronósticos de fútbol con modelo Dixon-Coles, cuotas reales y backtest fuera de muestra.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "dev:server": "node --watch server.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p . && node scripts/check-syntax.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm test && npm run build",
    "backtest": "node scripts/run-backtest.js",
    "fetch-history": "node scripts/fetch-history.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
