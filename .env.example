# Copia este archivo a .env para desarrollo local. NUNCA subas .env al repositorio.

# Acceso a la app (Basic Auth). Obligatorio en Render; usa una contraseña de 12+ caracteres.
APP_USERNAME=
APP_PASSWORD=
# REQUIRE_AUTH=true   # fuerza el inicio de sesión también en local

# Calendario y resultados: https://www.football-data.org/client/register (gratis, 10 llamadas/min)
FOOTBALL_DATA_TOKEN=
# Cuotas: https://the-odds-api.com (500 créditos/mes en el plan gratuito)
ODDS_API_KEY=
# Opcional: segunda opinión y bajas (solo informativo)
BIGBALLS_KEY=

# PostgreSQL (apuestas simuladas, caché y consumo de cuota persistentes)
DATABASE_URL=
DATABASE_CA_CERT=

# Banca
CURRENCY=MXN
STAKE=100
BANKROLL=5000
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.02

# The Odds API (plan gratuito: 500 créditos/mes ≈ 16 al día)
# Cada actualización por competición cuesta 1 crédito por mercado (h2h, totals, spreads = 3).
ODDS_MARKETS=h2h,totals,spreads
# Mercados por evento (cuestan créditos por partido). Vacío para desactivarlos.
ODDS_EXTRA_MARKETS=btts,double_chance
ODDS_EXTRAS_HOURS=30
ODDS_EXTRAS_CACHE_MINUTES=720
ODDS_EXTRAS_DAILY_BUDGET=4
ODDS_CACHE_MINUTES=240
ODDS_DAILY_CREDIT_BUDGET=16
# Créditos diarios que solo puede usar la captura de cuotas de cierre (CLV)
ODDS_CLOSING_RESERVE_CREDITS=6
ODDS_RESERVE_CREDITS=20
TRACK_CLOSING_ODDS=true

# Casa de ejecución: la cuota que realmente puedes tomar. Vacío = mejor cuota no
# atípica del mercado. Ej.: EXECUTION_BOOKMAKER=Pinnacle (si sale en The Odds API).
EXECUTION_BOOKMAKER=

# ValueBettingEngine (valores por defecto de la fase de validación)
VALUE_MIN_EV=0.05
VALUE_MAX_MARKET_GAP=0.10
VALUE_MIN_ODDS=1.50
VALUE_MAX_ODDS=4.00
VALUE_MIN_BOOKMAKERS=3
VALUE_MAX_BETS_PER_JORNADA=3

# Mezcla modelo + mercado para el EV (pesos en data/blend-weights.json).
# BLEND_ENABLED=false vuelve al modelo solo; BLEND_MODEL_WEIGHT fuerza un peso global (0–1).
BLEND_ENABLED=true
BLEND_MODEL_WEIGHT=

# paper = simulación (recomendado 30–60 días); live = dinero real
TRADING_MODE=paper
# auto | isotonic | platt
CALIBRATION_METHOD=auto
# Escaneo automático de señales y liquidación (minutos)
SIGNAL_SCAN_EVERY_MINUTES=120
SETTLE_EVERY_MINUTES=60

# Límite de peticiones por IP y minuto a /api
API_RATE_LIMIT_PER_MINUTE=120
PORT=3000
