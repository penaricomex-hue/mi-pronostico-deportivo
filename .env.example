# Copia este archivo a .env para desarrollo local. NUNCA subas .env al repositorio.

# Acceso a la app (Basic Auth). Obligatorio en Render; usa una contraseña de 12+ caracteres.
APP_USERNAME=
APP_PASSWORD=
# REQUIRE_AUTH=true   # fuerza el inicio de sesión también en local

# Calendario y resultados: https://www.football-data.org/client/register (gratis, 10 llamadas/min)
FOOTBALL_DATA_TOKEN=
# Cuotas: https://the-odds-api.com (500 créditos/mes en el plan gratuito)
ODDS_API_KEY=
# Opcional: segunda opinión y bajas (solo informativo)
BIGBALLS_KEY=

# PostgreSQL (obligatorio para cuotas, señales, calibración y rendimiento)
DATABASE_URL=
DATABASE_CA_CERT=

# Banca
CURRENCY=MXN
STAKE=100
BANKROLL=5000
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.02

# Protección de créditos de The Odds API
ODDS_CACHE_MINUTES=20
ODDS_DAILY_CREDIT_BUDGET=30
ODDS_RESERVE_CREDITS=40
TRACK_CLOSING_ODDS=true
# Mercados de The Odds API (por liga) y mercados extra por partido (cuestan créditos adicionales)
ODDS_MARKETS=h2h,totals,spreads
ODDS_EVENT_MARKETS=

# Motor de valor (ejecución en Caliente MX)
PAPER_TRADING=true
ENGINE_MIN_EV=0.05
ENGINE_MAX_MARKET_GAP=0.10
ENGINE_MIN_ODDS=1.50
ENGINE_MAX_ODDS=4.00
ENGINE_MAX_BETS_PER_MATCHDAY=3
ENGINE_MIN_MARKET_BOOKS=3

# Feed opcional de cuotas de Caliente MX (JSON). Sin feed, las cuotas se capturan en la app.
CALIENTE_FEED_URL=
CALIENTE_FEED_TOKEN=
CALIENTE_FEED_MINUTES=30

# Tareas automáticas
SIGNALS_EVERY_MINUTES=60
CALIBRATE_EVERY_HOURS=24
SETTLE_EVERY_MINUTES=60

# Límite de peticiones por IP y minuto a /api
API_RATE_LIMIT_PER_MINUTE=120
PORT=3000
