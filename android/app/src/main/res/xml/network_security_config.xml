<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS; sin certificados de usuario (evita interceptar el tráfico con proxies instalados). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
